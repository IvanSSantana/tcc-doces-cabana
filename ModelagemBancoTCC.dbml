Table Produto [headercolor: #175e7a] {
	ProdutoId uniqueidentifier [ pk, unique ]
	SubcategoriaId uniqueidentifier [ not null ]
	PromocaoId uniqueidentifier
	Nome varchar(255) [ not null ]
	Preco decimal(18,2) [ not null ]
	Status tinyint [ not null ]
	ImagemUrl nvarchar(255) [ not null ]
	Descricao nvarchar(4000) [ note: 'Opcional — produtos cadastrados antes da spec 008 ficam nulos até recadastro' ]
	SemAcucar bit [ not null, note: 'Característica do produto, não subcategoria (spec 012) — permitiu fundir Doces Caseiros e Doces Zero em uma única categoria sem perder a distinção' ]
}

// Usuario e ContaDeAcesso são as duas metades de uma mesma pessoa, separadas
// pela spec 004-separar-pessoa-de-credencial: Usuario é dado de negócio,
// ContaDeAcesso é a credencial do ASP.NET Identity. 1:1 por chave
// compartilhada — UsuarioId é ao mesmo tempo PK de Usuario e FK para
// ContaDeAcesso.Id.
Table Usuario [headercolor: #175e7a] {
	UsuarioId uniqueidentifier [ pk, unique ]
	Nome varchar(255) [ not null ]
	CPF varchar(11) [ not null, unique ]
	Celular varchar(11) [ not null ]
	DataNascimento date
}

Table ContaDeAcesso [headercolor: #175e7a] {
	Id uniqueidentifier [ pk, unique ]
	Email varchar(255)
	PasswordHash varchar(255)
}

Table Categoria [headercolor: #175e7a] {
	CategoriaId uniqueidentifier [ pk, not null, unique ]
	Nome nvarchar(100) [ not null ]
}

Table Subcategoria [headercolor: #175e7a] {
	SubcategoriaId uniqueidentifier [ pk, not null, unique ]
	CategoriaId uniqueidentifier [ not null ]
	Nome nvarchar(100) [ not null ]
}

Table Estoque [headercolor: #175e7a] {
	ProdutoId uniqueidentifier [ pk, not null, unique ]
	Quantidade smallint
}

Table Promocao [headercolor: #175e7a] {
	PromocaoId uniqueidentifier [ pk, unique ]
	Nome nvarchar(255)
	Descricao nvarchar(255)
	Tipo tinyint
	Valor decimal(18,2) [ not null ]
	DataInicio datetime2 [ not null ]
	DataFim datetime2 [ not null ]
	Ativa bit [ not null ]
}

Table Endereco [headercolor: #175e7a] {
	EnderecoId uniqueidentifier [ pk, not null, unique ]
	UsuarioId uniqueidentifier [ not null ]
	Estado nvarchar(100)
	Cidade nvarchar(150)
	Bairro varchar(255)
	CEP varchar(8)
	Rua varchar(255)
	Numero integer
	Complemento nvarchar(100)
}

Table Favorito [headercolor: #175e7a] {
	ProdutoId uniqueidentifier
	UsuarioId uniqueidentifier

	indexes {
		(ProdutoId, UsuarioId) [ pk ]
	}
}

Table Avaliacao [headercolor: #175e7a] {
	AvaliacaoId uniqueidentifier [ pk, unique ]
	UsuarioId uniqueidentifier [ not null ]
	ProdutoId uniqueidentifier [ not null ]
	Comentario varchar(255)
	Nota tinyint
	DataCriacao datetime2 [ not null, note: 'Gravada em UTC (spec 008)' ]
}

// Substitui o antigo Avaliacao.UpVote (bit solto, spec 008): um bool não
// conta votos nem sabe de quem é o voto. Chave composta é o que garante
// "uma pessoa vota no máximo uma vez por avaliação" no próprio banco.
Table VotoUtil [headercolor: #175e7a] {
	AvaliacaoId uniqueidentifier [ not null ]
	UsuarioId uniqueidentifier [ not null ]

	indexes {
		(AvaliacaoId, UsuarioId) [ pk ]
	}
}

Table Pedido [headercolor: #175e7a] {
	PedidoId uniqueidentifier [ pk, not null, unique ]
	UsuarioId uniqueidentifier [ not null ]
	EnderecoEntregaId uniqueidentifier [ not null ]
	PagamentoAprovado bit
	Valor decimal(18,2)
	Status tinyint
	Data datetime2
}

Table ItemPedido [headercolor: #175e7a] {
	ItemPedidoId uniqueidentifier [ pk, not null, unique ]
	ProdutoId uniqueidentifier [ not null ]
	PedidoId uniqueidentifier [ not null ]
	Quantidade smallint [ not null ]
	PrecoUnitario decimal(18,2) [ not null ]

	indexes {
		(ProdutoId, PedidoId) [ name: 'ItemPedido_index_0' ]
	}
}

Table Pagamento [headercolor: #175e7a] {
	PagamentoId uniqueidentifier [ pk, not null, unique ]
	PedidoId uniqueidentifier [ pk, not null, unique ]
	Metodo tinyint [ not null ]
	Status tinyint [ not null ]
	Valor decimal(18,2) [ not null ]
	DataPagamento datetime2
}

Ref fk_ItemPedido_ProdutoId_Produto {
	ItemPedido.ProdutoId - Produto.ProdutoId [ delete: no action, update: no action ]
}

Ref fk_ItemPedido_PedidoId_Pedido {
	ItemPedido.PedidoId - Pedido.PedidoId [ delete: no action, update: no action ]
}

Ref fk_Pedido_UsuarioId_Usuario {
	Pedido.UsuarioId > Usuario.UsuarioId [ delete: no action, update: no action ]
}

Ref fk_Pedido_EnderecoEntregaId_Endereco {
	Pedido.EnderecoEntregaId > Endereco.EnderecoId [ delete: no action, update: no action ]
}

Ref fk_Avaliacao_UsuarioId_Usuario {
	Avaliacao.UsuarioId > Usuario.UsuarioId [ delete: no action, update: no action ]
}

Ref fk_Avaliacao_ProdutoId_Produto {
	Avaliacao.ProdutoId > Produto.ProdutoId [ delete: no action, update: no action ]
}

Ref fk_Endereco_UsuarioId_Usuario {
	Endereco.UsuarioId > Usuario.UsuarioId [ delete: no action, update: no action ]
}

Ref fk_Favorito_ProdutoId_Produto {
	Favorito.ProdutoId > Produto.ProdutoId [ delete: no action, update: no action ]
}

Ref fk_Favorito_UsuarioId_Usuario {
	Favorito.UsuarioId > Usuario.UsuarioId [ delete: no action, update: no action ]
}

Ref fk_Pagamento_PedidoId_Pedido {
	Pagamento.PedidoId - Pedido.PedidoId [ delete: no action, update: no action ]
}

Ref fk_Estoque_ProdutoId_Produto {
	Estoque.ProdutoId - Produto.ProdutoId [ delete: no action, update: no action ]
}

Ref fk_Subcategoria_CategoriaId_Categoria {
	Subcategoria.CategoriaId > Categoria.CategoriaId [ delete: no action, update: no action ]
}

Ref fk_Produto_SubcategoriaId_Subcategoria {
	Produto.SubcategoriaId > Subcategoria.SubcategoriaId [ delete: no action, update: no action ]
}

Ref fk_Produto_PromocaoId_Promocao {
	Produto.PromocaoId > Promocao.PromocaoId [ delete: no action, update: no action ]
}

Ref fk_Usuario_UsuarioId_ContaDeAcesso {
	Usuario.UsuarioId - ContaDeAcesso.Id [ delete: cascade, update: no action ]
}

Ref fk_VotoUtil_AvaliacaoId_Avaliacao {
	VotoUtil.AvaliacaoId > Avaliacao.AvaliacaoId [ delete: cascade, update: no action ]
}

Ref fk_VotoUtil_UsuarioId_Usuario {
	VotoUtil.UsuarioId > Usuario.UsuarioId [ delete: no action, update: no action ]
}
