<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <!-- Banco no Postgres do Supabase (spec 028). O pin de
         SQLitePCLRaw.lib.e_sqlite3 que existia aqui saiu junto com o SQLite —
         era só para tapar a vulnerabilidade GHSA-2m69-gcr7-jv3q da versão
         transitiva que o provider antigo arrastava. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocesCabana.Domain\DocesCabana.Domain.csproj" />
    <ProjectReference Include="..\DocesCabana.Application\DocesCabana.Application.csproj" />
  </ItemGroup>

</Project>
