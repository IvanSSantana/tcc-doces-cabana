<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocesCabana.MVC</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/card-produto.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/vitrine-produtos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/modal-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DocesCabana.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    @await Component.InvokeAsync("Header")   

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />
    <partial name="_ModalLogin" />

    @* Alvo de submissão do coração de favoritar (spec 015) — vive fora de
       qualquer form da página de propósito, porque o cartão de produto pode
       estar dentro do <form method="get"> do catálogo, e HTML não aceita
       form aninhado. Cada botão se associa a este pelo atributo form= do
       HTML5; o returnUrl é o mesmo para todo cartão desta página, porque
       todos vêm da mesma requisição. *@
    <form id="formulario-favorito" asp-area="" asp-controller="Favorito" asp-action="Alternar" method="post" hidden>
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
    </form>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components/vitrine-produtos.js" asp-append-version="true"></script>
    <script src="~/js/components/modal-login.js" asp-append-version="true"></script>
    <script src="~/js/components/favorito.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
