<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DocesCabana.MVC</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/card-produto.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/vitrine-produtos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/modal-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DocesCabana.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    @await Component.InvokeAsync("Header")   

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />
    <partial name="_ModalLogin" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components/card-produto.js" asp-append-version="true"></script>
    <script src="~/js/components/vitrine-produtos.js" asp-append-version="true"></script>
    <script src="~/js/components/modal-login.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
