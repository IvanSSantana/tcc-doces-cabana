@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<main class="pagina-mensagem">
    <h1 class="titulo titulo--na-pagina">Algo deu errado</h1>

    <p>Não foi possível concluir a sua solicitação. Tente de novo em alguns instantes.</p>

    @if (Model.ShowRequestId)
    {
        <p class="pagina-mensagem__detalhe">
            Código da solicitação: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-area="" asp-controller="Home" asp-action="Index" class="botao botao--primario">Voltar para a loja</a>
</main>
