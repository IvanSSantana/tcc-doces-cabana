<dialog id="modal-login" class="modal-autenticacao">
    <div class="container-modal">
        <button class="botao-fechar" onclick="fecharModal()" aria-label="Fechar">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <div class="logo-modal">
            <img src="~/images/logo.webp" alt="Logo Doce Cabana">
        </div>

        <div class="acoes-modal">
            <a asp-action="Cadastro" asp-controller="Autenticacao" class="botao-modal botao-cadastro">Cadastre-se</a>
            <a asp-action="Login" asp-controller="Autenticacao" class="botao-modal botao-entrar">Entrar</a>
        </div>

        <div class="rodape-modal">
            <a asp-controller="Institucional" asp-action="Privacidade" class="link-privacidade">Política de Privacidade</a>
        </div>
    </div>
</dialog>