@using DocesCabana.Application.DTOs
@model IEnumerable<ProdutoDTO>

<div class="vitrine-carrossel">
    <div class="conteudo-carrossel">
        <button class="seta-carrossel prev" aria-label="Anterior" onclick="irItemAnterior(this)">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        
        <div class="area-carrossel">
            <div class="itens-carrossel-container">
                @foreach (var produto in Model)
                {
                    <div class="item-carrossel">
                        @await Component.InvokeAsync("CardProduto", new { produto = produto, estaFavorito = false })
                    </div>
                }
            </div>
        </div>
        
        <button class="seta-carrossel next" aria-label="Próximo" onclick="irProximoItem(this)">
            <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>
    
    <div class="indicadores-carrossel">
        @for (int i = 0; i < Model.Count(); i++)
        {
            <button class="ponto-indicador @(i == 0 ? "active" : "")" 
                    aria-label="Ir para slide @(i + 1)" 
                    data-indice-item="@i" 
                    onclick="irParaItem(this, @i)"></button>
        }
    </div>
</div>
