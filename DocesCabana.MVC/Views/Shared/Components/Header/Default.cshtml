<head>
  <link rel="stylesheet" href="~/css/components/header.css">
</head>

<body>
  <header>
    <div class="cabecalho-superior">
      <section>

        <a href="/" class="logo">
          <img
            src="https://images.squarespace-cdn.com/content/v1/682f45db7481367eb4ac9803/e90a234b-bab5-4839-b072-59ca8ae7aff2/Logo+Aprova%C3%A7%C3%A3o+Final+Doce+Cabana+rgb.png?format=1500w"
            alt="Logo Doce Cabana">
        </a>

        <div class="barra-pesquisa">
          <input type="text" placeholder="Buscar produto...">

          <div class="separador-pesquisa"></div>

          <button class="btn-pesquisar" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>

        </div>

        <div class="acoes-usuario">
          <a href="#" class="btn-acao">

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>

            <span>Entrar</span>
          </a>

          <a href="#" class="btn-acao">

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>

            <span>Meu carrinho</span>
          </a>

        </div>
      </section>

    </div>


    <div class="cabecalho-inferior">
      <section>
        <nav>

          <a href="#" class="link-nav">
            <p>Doce</p>

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>

          </a>

          <a href="#" class="link-nav">
            <p>Salgado</p>

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>

          </a>

          <a href="#" class="link-nav">
            <p>Adega</p>

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>

          </a>

          <a href="#" class="link-nav">
            <p>Outros</p>

            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>

          </a>

        </nav>

        <a href="#" class="btn-favoritos">
          <span>Favoritos</span>

          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
            </path>
          </svg>

        </a>
      </section>

    </div>
  </header>
</body>

</html>