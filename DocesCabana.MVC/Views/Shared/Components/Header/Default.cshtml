@using Microsoft.AspNetCore.Identity;
@using DocesCabana.Domain;
@using DocesCabana.Application.DTOs;
@model List<CategoriaDTO>

<head>
  <link rel="stylesheet" href="~/css/components/header.css">
</head>

<header>
  <div class="cabecalho-superior">
    <section>

      <a asp-area="" asp-action="Index" asp-controller="Home" class="logo">
        <img
          src="~/images/logo.webp"
          alt="Logo Doce Cabana">
      </a>

      @* Busca por nome de produto (spec 016, RF-01/RF-02): varre a loja
         inteira, sempre no catálogo, sem categoria — a barra vive aqui, no
         cabeçalho, presente inclusive na home, onde não há categoria
         nenhuma. Formulário comum, GET, sem interceptação — sempre navega
         de verdade para /Catalogo, com ou sem JavaScript (RF-10). É só a
         partir daí, já dentro do catálogo, que #formulario-catalogo (com o
         termo como campo oculto) assume o refinamento sem recarga. *@
      @* asp-route-apelido="null" explícito (não omitido) é o que impede o
         gerador de endereço de herdar o apelido de categoria da página
         atual como valor ambiente — sem isso, buscar de dentro de
         /Catalogo/doces submeteria para /Catalogo/doces, não para o
         catálogo inteiro (RF-02). *@
      <form asp-area="" asp-controller="Catalogo" asp-action="Index" asp-route-apelido="@((string?)null)"
            method="get" class="barra-pesquisa">
        <input type="text" name="termo" value="@ViewData["TermoDeBusca"]"
               placeholder="Buscar produto..." aria-label="Buscar produto">

        <div class="separador-pesquisa"></div>

        <button type="submit" class="botao-pesquisar" aria-label="Buscar">
          <i class="fa-solid fa-magnifying-glass icone-pesquisa"></i>
        </button>

      </form>

      <div class="acoes-usuario">
        @if (User.Identity!.IsAuthenticated)
        {
          @* RF-17 (spec 014): a página de conta ainda não existe — o atalho
             levava a Home/Conta, que não é uma ação e cai no 404. Desabilitado
             em vez de escondido, mesmo padrão dos controles do card (spec
             012, RF-24), até a tela existir de verdade. *@
          <span class="botao-acao botao-acao--desabilitado" aria-disabled="true" title="Ainda não disponível">
            <i class="fa-solid fa-user icone-acao"></i>

            <span>Conta</span>
          </span>

          @if (User.IsInRole(Papeis.Administrador))
          {
            <a class="botao-acao" asp-area="Admin" asp-controller="Administrador" asp-action="Index">
              <i class="fa-solid fa-user-shield icone-acao"></i>

              <span>Administradores</span>
            </a>

            @* RF-26 (spec 015): a tela de cadastro de produto sempre
               existiu, protegida por [Authorize], mas só era alcançável
               digitando o endereço — nenhuma view tinha link para ela. *@
            <a class="botao-acao" asp-area="Admin" asp-controller="Produto" asp-action="Cadastro">
              <i class="fa-solid fa-plus icone-acao"></i>

              <span>Cadastrar produto</span>
            </a>
          }

          <form asp-area="" asp-controller="Autenticacao" asp-action="Logout" method="post" class="formulario-sair">
            @Html.AntiForgeryToken()
            <button type="submit" class="botao-acao botao-sair" aria-label="Sair">
              <i class="fa-solid fa-right-from-bracket icone-acao"></i>

              <span>Sair</span>
            </button>
          </form>
        }
        else 
        {
          <a class="botao-acao" onclick="abrirModal()">
            <i class="fa-solid fa-user icone-acao"></i>

            <span>Entrar</span>
          </a>
        }        

        @{
            var itensCarrinho = (int)(ViewData["ItensCarrinho"] ?? 0);
        }
        @* CA-16: o atalho deixa de ser href="#" — chega à tela do carrinho de
           verdade. CA-15: a bolha só aparece com item — não é um "0"
           desenhado (plano §3). *@
        <a asp-area="" asp-controller="Carrinho" asp-action="Index" class="botao-acao">
          <span class="icone-com-bolha">
            <i class="fa-solid fa-cart-shopping icone-acao"></i>
            <span class="bolha-carrinho" data-bolha-carrinho hidden="@(itensCarrinho == 0 ? "hidden" : null)">@itensCarrinho</span>
          </span>

          <span>Meu carrinho</span>
        </a>

      </div>
    </section>

  </div>


  <div class="cabecalho-inferior">
    <section>
      <nav>

        @foreach (var categoria in Model)
        {
          @* Menu suspenso por CSS puro (:hover/:focus-within), sem
             JavaScript — abre ao passar o mouse ou ao tabular até o link
             (spec 012, plano §3/§9). Só as 8 subcategorias com mais produto
             disponível aparecem aqui (RF-04/RN-06); a lista completa mora na
             barra lateral do catálogo. *@
          <div class="item-categoria-nav">
            <a asp-area="" asp-controller="Catalogo" asp-action="Index" asp-route-apelido="@categoria.Apelido" class="link-nav">
              <p>@categoria.Nome</p>

              @if (categoria.Subcategorias.Count > 0)
              {
                <i class="fa-solid fa-chevron-down icone-nav seta-header" aria-hidden="true"></i>
              }
            </a>

            @if (categoria.Subcategorias.Count > 0)
            {
              <div class="submenu-categoria">
                <ul>
                  @foreach (var subcategoria in categoria.Subcategorias.Take(8))
                  {
                    <li>
                      <a asp-area="" asp-controller="Catalogo" asp-action="Index"
                         asp-route-apelido="@categoria.Apelido" asp-route-subcategorias="@subcategoria.Apelido">
                        @subcategoria.Nome
                      </a>
                    </li>
                  }
                </ul>
              </div>
            }
          </div>
        }

      </nav>

      @* Levava a lugar nenhum (href="#") até a lista existir de verdade
         (spec 015) — o mesmo defeito que o cadastro de produto sem link
         tinha, ao contrário: aqui a tela existia e faltava o caminho. *@
      <a asp-area="" asp-controller="Favorito" asp-action="Index" class="botao-favoritos">
        <span>Favoritos</span>

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
          </path>
        </svg>

      </a>
    </section>

  </div>
</header>