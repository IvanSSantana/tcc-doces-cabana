<link rel="stylesheet" href="~/css/components/categorias.css" asp-append-version="true" />

<div class="categorias-container">
    <div class="area-categorias">
        
        <a asp-controller="Produto" asp-action="Categoria" asp-route-id="salgados" class="item-categoria">
            <div class="area-imagem-categoria">
                <img src="~/images/shapes/hexagono.svg" alt="Forma Hexágono" class="forma-fundo" />
                <img src="~/images/categoria_salgados.png" alt="Salgados" class="imagem-categoria" />
            </div>
            <span class="nome-categoria">SALGADOS</span>
        </a>

        <a asp-controller="Produto" asp-action="Categoria" asp-route-id="doces" class="item-categoria">
            <div class="area-imagem-categoria">
                <img src="~/images/shapes/estrela_invertida.svg" alt="Forma Estrela" class="forma-fundo estrela" />
                <img src="~/images/categoria_doces.png" alt="Doces" class="imagem-categoria" />
            </div>
            <span class="nome-categoria">DOCES</span>
        </a>

        <a asp-controller="Produto" asp-action="Categoria" asp-route-id="adega" class="item-categoria terceira-categoria">
            <div class="area-imagem-categoria">
                <img src="~/images/shapes/hexagono.svg" alt="Forma Hexágono" class="forma-fundo" />
                <img src="~/images/categoria_adega.png" alt="Adega" class="imagem-categoria" />
            </div>
            <span class="nome-categoria">ADEGA</span>
        </a>

        <a asp-controller="Produto" asp-action="Categoria" asp-route-id="outros" class="item-categoria">
            <div class="area-imagem-categoria">
                <img src="~/images/shapes/estrela.svg" alt="Forma Estrela" class="forma-fundo estrela" />
                <img src="~/images/categoria_outros.png" alt="Outros" class="imagem-categoria" />
            </div>
            <span class="nome-categoria">OUTROS</span>
        </a>

    </div>
</div>