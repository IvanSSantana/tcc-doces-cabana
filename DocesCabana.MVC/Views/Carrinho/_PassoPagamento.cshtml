@using DocesCabana.Application.DTOs
@using DocesCabana.Domain.Enums
@model PassoDoFechamentoDTO

@{
    var opcaoEscolhida = Model.Cotacao?.Opcoes.FirstOrDefault(o => o.ServicoId == Model.ServicoDeEntregaSelecionadoId);

    var rotulosDePagamento = new Dictionary<MetodoPagamento, string>
    {
        [MetodoPagamento.Pix] = "Pix",
        [MetodoPagamento.CartaoCredito] = "Cartão de crédito",
        [MetodoPagamento.CartaoDebito] = "Cartão de débito",
        [MetodoPagamento.Boleto] = "Boleto",
    };

    var iconesDePagamento = new Dictionary<MetodoPagamento, string>
    {
        [MetodoPagamento.Pix] = "fa-brands fa-pix",
        [MetodoPagamento.CartaoCredito] = "fa-regular fa-credit-card",
        [MetodoPagamento.CartaoDebito] = "fa-solid fa-credit-card",
        [MetodoPagamento.Boleto] = "fa-solid fa-barcode",
    };

    var itemIndisponivel = ViewData["ItemIndisponivel"] as string;
    var valorDosProdutosAtual = ViewData["ValorDosProdutosAtual"] as decimal?;
    var valorDoFreteAtual = ViewData["ValorDoFreteAtual"] as decimal?;
    var descontoDoCupomAtual = ViewData["DescontoDoCupomAtual"] as decimal?;
    var erroGeral = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<div class="passo-pagamento-fechamento">
    <h2 class="titulo-passo-fechamento">Como você quer pagar?</h2>

    @if (Model.EnderecoSelecionadoId is null || opcaoEscolhida is null)
    {
        <p>
            Escolha um endereço e uma opção de entrega antes de continuar.
            <a asp-action="Index" asp-route-passo="Endereco" data-navegacao-fechamento>Voltar para o endereço</a>
        </p>
    }
    else
    {
        @if (erroGeral is not null)
        {
            <p class="mensagem-erro exibicao-bloco">@erroGeral</p>
        }
        @if (itemIndisponivel is not null)
        {
            <p class="mensagem-erro exibicao-bloco">@itemIndisponivel não está mais disponível — remova-o do carrinho para continuar.</p>
        }
        @if (valorDosProdutosAtual is not null)
        {
            <p class="mensagem-erro exibicao-bloco">O valor dos produtos agora é R$ @valorDosProdutosAtual.Value.ToString("N2").</p>
        }
        @if (valorDoFreteAtual is not null)
        {
            <p class="mensagem-erro exibicao-bloco">O valor do frete agora é R$ @valorDoFreteAtual.Value.ToString("N2").</p>
        }
        @if (descontoDoCupomAtual is not null)
        {
            <p class="mensagem-erro exibicao-bloco">O desconto do cupom agora é R$ @descontoDoCupomAtual.Value.ToString("N2").</p>
        }

        <form method="post" asp-controller="Pedido" asp-action="Fechar" class="formulario-pagamento-fechamento">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EnderecoId" value="@Model.EnderecoSelecionadoId" />
            <input type="hidden" name="ServicoDeEntregaId" value="@opcaoEscolhida.ServicoId" />
            @* Cultura atual (pt-BR, vírgula decimal): o model binder lê o formulário nessa mesma cultura.
               Com InvariantCulture, "139.80" seria lido como 13980. *@
            <input type="hidden" name="ValorDosProdutosExibido" value="@Model.Carrinho.Subtotal.ToString(System.Globalization.CultureInfo.CurrentCulture)" />
            <input type="hidden" name="ValorDoFreteExibido" value="@opcaoEscolhida.Preco.ToString(System.Globalization.CultureInfo.CurrentCulture)" />
            @if (Model.CupomValido)
            {
                <input type="hidden" name="CodigoDoCupom" value="@Model.Cupom!.Codigo" />
                <input type="hidden" name="DescontoDoCupomExibido" value="@Model.DescontoTotalDoCupom.ToString(System.Globalization.CultureInfo.CurrentCulture)" />
            }

            <fieldset class="opcoes-pagamento-fechamento">
                <legend>Forma de pagamento</legend>
                <div class="grade-pagamento-fechamento">
                    @foreach (var metodo in rotulosDePagamento.Keys)
                    {
                        <label class="opcao-pagamento-fechamento">
                            <input type="radio" name="MetodoPagamento" value="@((int)metodo)"
                                   checked="@(metodo == MetodoPagamento.Pix ? "checked" : null)" />
                            <i class="@iconesDePagamento[metodo] icone-pagamento-fechamento" aria-hidden="true"></i>
                            <span class="nome-pagamento-fechamento">@rotulosDePagamento[metodo]</span>
                        </label>
                    }
                </div>
            </fieldset>

            <p class="aviso-pagamento-fechamento">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                <span>Nenhum dado de pagamento é coletado aqui. Depois de confirmar, a forma de pagamento é combinada
                diretamente com a loja.</span>
            </p>

            <div class="painel painel--rebaixado resumo-pagamento-fechamento">
                <p>Produtos <strong>R$ @Model.Carrinho.Subtotal.ToString("N2")</strong></p>
                @if (Model.CupomValido && Model.Cupom!.DescontoNosProdutos > 0)
                {
                    <p class="linha-desconto-pedido"><span>Cupom <span class="codigo-linha-desconto">@Model.Cupom.Codigo</span></span> <strong>&minus; R$ @Model.Cupom.DescontoNosProdutos.ToString("N2")</strong></p>
                }
                @if (Model.CupomValido && Model.Cupom!.DescontoNoFrete > 0)
                {
                    <p>Entrega <strong><s class="valor-riscado">R$ @opcaoEscolhida.Preco.ToString("N2")</s> <span class="frete-gratis">Grátis</span></strong></p>
                }
                else
                {
                    <p>Entrega <strong>R$ @opcaoEscolhida.Preco.ToString("N2")</strong></p>
                }
                <p class="total-pagamento-fechamento">Total <strong>R$ @Model.ValorTotal.ToString("N2")</strong></p>
            </div>

            <button type="submit" class="botao botao--destaque botao-acao botao-confirmar-pedido">Confirmar pedido</button>
        </form>
    }
</div>
