@using DocesCabana.Application.DTOs
@using DocesCabana.Application.Enums
@model CarrinhoDTO

<div id="itens-carrinho" data-total-itens="@Model.TotalDeItens" tabindex="-1">
    @if (Model.Linhas.Count == 0)
    {
        <p class="carrinho-vazio">
            Seu carrinho está vazio.
            <a asp-area="" asp-controller="Catalogo" asp-action="Index">Ver o catálogo</a>
        </p>
    }
    else
    {
        var passoDoFechamento = ViewData["PassoDoFechamento"] as PassoDoFechamentoDTO;
        var passoAtivo = passoDoFechamento?.PassoAtivo ?? PassoDoFechamento.Carrinho;

        if (passoDoFechamento is not null)
        {
            <partial name="~/Views/Carrinho/_PassosDoFechamento.cshtml" model="passoDoFechamento" />
        }

        <div class="grade-carrinho">
            <div class="coluna-itens-carrinho">
            @if (passoAtivo != PassoDoFechamento.Carrinho && passoDoFechamento is not null)
            {
                if (passoAtivo == PassoDoFechamento.Conta)
                {
                    <partial name="~/Views/Carrinho/_PassoConta.cshtml" />
                }
                else if (passoAtivo == PassoDoFechamento.Endereco)
                {
                    <partial name="~/Views/Carrinho/_PassoEndereco.cshtml" model="passoDoFechamento" />
                }
                else
                {
                    <partial name="~/Views/Carrinho/_PassoPagamento.cshtml" model="passoDoFechamento" />
                }
            }
            else
            {
                <ul class="lista-itens-carrinho">
                    @foreach (var linha in Model.Linhas)
                    {
                        <li class="item-carrinho @(linha.Disponivel ? "" : "item-carrinho--indisponivel")" data-produto-id="@linha.ProdutoId">
                            <img src="@linha.ImagemUrl" alt="@linha.Nome" class="imagem-item-carrinho" />

                            <div class="detalhes-item-carrinho">
                                <span class="nome-item-carrinho">@linha.Nome</span>

                                @if (linha.Disponivel && linha.RotuloDaPromocao is not null)
                                {
                                    <span class="promocao-item-carrinho">
                                        <span class="selo-promocao">@linha.RotuloDaPromocao</span>
                                        <span>&minus; R$ @linha.DescontoDaPromocao.ToString("N2")</span>
                                    </span>
                                }

                                @if (linha.Disponivel)
                                {
                                    <div class="colunas-item-carrinho">
                                        <div class="coluna-item-carrinho">
                                            <span class="rotulo-coluna-carrinho">Preço unitário (R$)</span>
                                            <span class="preco-item-carrinho">R$ @linha.PrecoUnitario.ToString("N2")</span>
                                        </div>

                                        <div class="coluna-item-carrinho">
                                            <span class="rotulo-coluna-carrinho">Quantidade</span>

                                            <form method="post" asp-action="AlterarQuantidade" class="formulario-quantidade-carrinho">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="produtoId" value="@linha.ProdutoId" />
                                                <button type="submit" name="quantidade" value="@(linha.Quantidade - 1)"
                                                        class="botao-quantidade-carrinho menos" aria-label="Diminuir quantidade">&minus;</button>
                                                <span class="valor-quantidade-carrinho">@linha.Quantidade</span>
                                                <button type="submit" name="quantidade" value="@(linha.Quantidade + 1)"
                                                        class="botao-quantidade-carrinho mais" aria-label="Aumentar quantidade">+</button>
                                            </form>
                                        </div>

                                        <div class="coluna-item-carrinho">
                                            <span class="rotulo-coluna-carrinho">Subtotal (R$)</span>
                                            <span class="valor-linha-carrinho">R$ @linha.ValorDaLinha.ToString("N2")</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="motivo-indisponivel-carrinho">
                                        @(linha.MotivoIndisponibilidade == MotivoIndisponibilidade.ForaDeEstoque
                                            ? "Fora de estoque — não entra no total"
                                            : "Saiu do catálogo — não entra no total")
                                    </span>
                                }
                            </div>

                            <form method="post" asp-action="Remover" class="formulario-remover-carrinho">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="produtoId" value="@linha.ProdutoId" />
                                <button type="submit" class="botao-remover-carrinho" aria-label="Remover @linha.Nome">&times;</button>
                            </form>
                        </li>
                    }
                </ul>

                <div class="acoes-lista-carrinho">
                    <a asp-action="ConfirmarEsvaziar" class="botao botao--perigo botao--pequeno botao-esvaziar-lista-carrinho" data-abrir-confirmacao-esvaziar>
                        Esvaziar carrinho
                    </a>

                    <a asp-area="" asp-controller="Catalogo" asp-action="Index" class="botao botao--fantasma botao-continuar-comprando">
                        Continuar comprando →
                    </a>
                </div>
            }
            </div>

            <aside class="painel resumo-carrinho">
                <h2 class="titulo-resumo-carrinho">Resumo do pedido</h2>

                @{
                    var cupom = passoDoFechamento?.Cupom;
                    var cupomValido = passoDoFechamento?.CupomValido == true;
                    var descontoNosProdutos = cupomValido ? cupom!.DescontoNosProdutos : 0m;
                    var freteGratis = cupomValido && cupom!.FreteGratis && cupom.DescontoNoFrete > 0;
                    var erroCupom = ViewData.ModelState["Codigo"]?.Errors.FirstOrDefault()?.ErrorMessage;
                    var codigoDigitado = ViewData.ModelState["Codigo"]?.AttemptedValue;
                }

                <div class="campo-cupom-carrinho">
                    @if (User.Identity is not { IsAuthenticated: true })
                    {
                        <label for="cupom-carrinho">Cupom de desconto</label>
                        <div class="entrada-cupom-carrinho">
                            <input type="text" id="cupom-carrinho" disabled placeholder="Código do cupom"
                                   aria-describedby="explicacao-cupom-carrinho" />
                            <button type="button" class="botao botao--secundario botao--pequeno" onclick="abrirModal()">Entrar</button>
                        </div>
                        <span id="explicacao-cupom-carrinho" class="explicacao-cupom-carrinho">Entre na sua conta para usar um cupom.</span>
                    }
                    else if (cupom is not null)
                    {
                        <span class="titulo-cupom-carrinho">Cupom de desconto</span>
                        <div class="cupom-aplicado @(cupomValido ? "" : "cupom-aplicado--sem-efeito")">
                            <div class="canhoto-cupom">
                                <span class="codigo-canhoto-cupom">@cupom.Codigo</span>
                                @if (!string.IsNullOrEmpty(cupom.Rotulo))
                                {
                                    <span class="rotulo-canhoto-cupom">@cupom.Rotulo</span>
                                }
                            </div>
                            <form method="post" asp-controller="Carrinho" asp-action="RemoverCupom" class="formulario-remover-cupom">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="botao-remover-cupom" aria-label="Remover o cupom @cupom.Codigo">Remover</button>
                            </form>
                        </div>
                        @if (!cupomValido)
                        {
                            <p class="motivo-cupom-carrinho" role="status">@cupom.Motivo</p>
                        }
                    }
                    else
                    {
                        <form method="post" asp-controller="Carrinho" asp-action="AplicarCupom" class="formulario-cupom-carrinho" novalidate>
                            @Html.AntiForgeryToken()
                            <label for="cupom-carrinho">Cupom de desconto</label>
                            <div class="entrada-cupom-carrinho">
                                <input type="text" id="cupom-carrinho" name="Codigo" value="@codigoDigitado"
                                       maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false"
                                       placeholder="Código do cupom"
                                       aria-invalid="@(erroCupom is not null ? "true" : null)"
                                       aria-describedby="@(erroCupom is not null ? "erro-cupom-carrinho" : null)" />
                                <button type="submit" class="botao botao--secundario botao--pequeno">Aplicar</button>
                            </div>
                            @if (erroCupom is not null)
                            {
                                <span id="erro-cupom-carrinho" class="mensagem-erro">@erroCupom</span>
                            }
                        </form>
                    }
                </div>

                <p class="total-itens-carrinho">@Model.TotalDeItens ite@(Model.TotalDeItens == 1 ? "m" : "ns")</p>

                @{
                    var haItemDisponivel = Model.Linhas.Any(l => l.Disponivel);
                    var erroCep = ViewData.ModelState["Cep"]?.Errors.FirstOrDefault()?.ErrorMessage;

                    // Nos passos Endereço e Pagamento o resumo segue a cotação do endereço escolhido,
                    // a mesma da escolha de entrega; a estimativa por CEP digitado fica só no passo Carrinho.
                    var resumoPeloEndereco = passoDoFechamento is not null
                        && passoAtivo is PassoDoFechamento.Endereco or PassoDoFechamento.Pagamento;
                    var entregaEscolhida = resumoPeloEndereco
                        ? passoDoFechamento!.Cotacao?.Opcoes.FirstOrDefault(o => o.ServicoId == passoDoFechamento.ServicoDeEntregaSelecionadoId)
                        : null;

                    // Com cupom, o total vem do passo (produtos + frete de referência − descontos do cupom).
                    var totalLiquido = passoDoFechamento?.ValorTotal ?? Model.ValorTotal;
                }

                @if (descontoNosProdutos > 0)
                {
                    <p class="linha-desconto-carrinho">
                        Cupom <span class="codigo-linha-desconto">@cupom!.Codigo</span>
                        <strong>&minus; R$ @descontoNosProdutos.ToString("N2")</strong>
                    </p>
                }

                @if (resumoPeloEndereco && passoDoFechamento!.RetiradaNaLoja)
                {
                    var faixaDoResumo = passoDoFechamento.FaixaSelecionada;
                    var textoDaFaixa = faixaDoResumo is null
                        ? string.Empty
                        : " (hoje, " + faixaDoResumo.Inicio.ToString("HH:mm") + "–" + faixaDoResumo.Fim.ToString("HH:mm") + ")";
                    <p class="linha-frete-carrinho">
                        Retirada na loja@(textoDaFaixa)
                        <strong><span class="frete-gratis">Grátis</span></strong>
                    </p>
                    <p class="subtotal-carrinho">
                        Total a pagar <strong>R$ @totalLiquido.ToString("N2")</strong>
                    </p>
                }
                else if (resumoPeloEndereco)
                {
                    @if (entregaEscolhida is not null)
                    {
                        <p class="linha-frete-carrinho">
                            Entrega (@entregaEscolhida.Transportadora — @entregaEscolhida.Servico)
                            @if (freteGratis)
                            {
                                <strong><s class="valor-riscado">R$ @entregaEscolhida.Preco.ToString("N2")</s> <span class="frete-gratis">Grátis</span></strong>
                            }
                            else
                            {
                                <strong>R$ @entregaEscolhida.Preco.ToString("N2")</strong>
                            }
                        </p>
                        <p class="subtotal-carrinho">
                            Total a pagar <strong>R$ @totalLiquido.ToString("N2")</strong>
                        </p>
                    }
                    else
                    {
                        <p class="linha-frete-carrinho">Escolha o endereço e a entrega para ver o total.</p>
                        <p class="subtotal-carrinho">
                            Subtotal <strong>R$ @totalLiquido.ToString("N2")</strong>
                        </p>
                    }
                }
                else if (haItemDisponivel)
                {
                    <form method="get" asp-controller="Carrinho" asp-action="Index" class="formulario-frete-carrinho">
                        @* Mantém o passo do fechamento: sem isso, consultar o CEP volta para o passo Carrinho *@
                        @if (passoDoFechamento is not null && passoAtivo != PassoDoFechamento.Carrinho)
                        {
                            <input type="hidden" name="passo" value="@passoAtivo" />
                            @if (passoDoFechamento.EnderecoSelecionadoId is not null)
                            {
                                <input type="hidden" name="enderecoId" value="@passoDoFechamento.EnderecoSelecionadoId" />
                            }
                            @if (passoDoFechamento.ServicoDeEntregaSelecionadoId is not null)
                            {
                                <input type="hidden" name="servicoDeEntregaId" value="@passoDoFechamento.ServicoDeEntregaSelecionadoId" />
                            }
                        }
                        <label for="cep-carrinho">Calcular frete</label>
                        <div class="entrada-cep-carrinho">
                            <input type="text" id="cep-carrinho" name="cep" value="@Model.Cotacao?.CepConsultado" placeholder="00000-000" maxlength="9" inputmode="numeric" autocomplete="postal-code" />
                            <button type="submit" class="botao botao--primario botao--pequeno">Calcular</button>
                        </div>

                        @if (erroCep is not null)
                        {
                            <span class="mensagem-erro">@erroCep</span>
                        }
                    </form>

                    @if (Model.Cotacao is not null)
                    {
                        <partial name="~/Views/Carrinho/_OpcoesDeFrete.cshtml" model="Model.Cotacao" />
                    }
                }

                @if (resumoPeloEndereco)
                {
                    @* totais já exibidos acima, pela entrega escolhida *@
                }
                else if (Model.TemEntregaCalculada)
                {
                    var freteMaisBarato = Model.Cotacao!.Opcoes.Min(o => o.Preco);
                    <p class="linha-frete-carrinho">
                        Frete
                        @if (freteGratis)
                        {
                            <strong><s class="valor-riscado">R$ @freteMaisBarato.ToString("N2")</s> <span class="frete-gratis">Grátis</span></strong>
                        }
                        else
                        {
                            <strong>R$ @freteMaisBarato.ToString("N2")</strong>
                        }
                    </p>
                    <p class="subtotal-carrinho">
                        Total a pagar <strong>R$ @totalLiquido.ToString("N2")</strong>
                    </p>
                }
                else
                {
                    <p class="linha-frete-carrinho">
                        @(cupomValido && cupom!.FreteGratis
                            ? "Calcule o frete: o cupom cobre a entrega escolhida."
                            : "Calcule o frete no carrinho para ver o total.")
                    </p>
                    <p class="subtotal-carrinho">
                        Subtotal <strong>R$ @totalLiquido.ToString("N2")</strong>
                    </p>
                }

                @if (passoAtivo == PassoDoFechamento.Carrinho && haItemDisponivel)
                {
                    var proximoPasso = User.Identity is { IsAuthenticated: true } ? PassoDoFechamento.Endereco : PassoDoFechamento.Conta;
                    <a asp-action="Index" asp-route-passo="@proximoPasso" data-navegacao-fechamento
                       class="botao botao--destaque botao-finalizar-carrinho">
                        Finalizar compra
                    </a>
                }
            </aside>
        </div>

        <dialog id="dialogo-esvaziar-carrinho" class="dialogo-esvaziar-carrinho">
            <form method="post" asp-action="Esvaziar" class="formulario-esvaziar-carrinho">
                @Html.AntiForgeryToken()
                <p>Esvaziar o carrinho? Todos os itens serão removidos.</p>
                <div class="acoes-dialogo-esvaziar-carrinho">
                    <button type="submit" class="botao botao--destaque botao--pequeno botao-confirmar-esvaziar-carrinho">Sim, esvaziar</button>
                    <button type="button" class="botao botao--fantasma botao--pequeno botao-cancelar-esvaziar-carrinho" data-fechar-dialogo-esvaziar>Cancelar</button>
                </div>
            </form>
        </dialog>
    }
</div>
