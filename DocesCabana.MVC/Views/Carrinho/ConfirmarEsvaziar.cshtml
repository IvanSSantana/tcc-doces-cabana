@{
    ViewData["Title"] = "Esvaziar carrinho";
}

<main class="pagina-confirmar-esvaziar">
    <h1 class="titulo-carrinho">Esvaziar o carrinho?</h1>

    <p>Todos os itens do seu carrinho serão removidos. Essa ação não pode ser desfeita.</p>

    <div class="acoes-confirmar-esvaziar">
        <form method="post" asp-action="Esvaziar">
            @Html.AntiForgeryToken()
            <button type="submit" class="botao-confirmar-esvaziar">Sim, esvaziar</button>
        </form>

        <a asp-action="Index" class="botao-cancelar-esvaziar">Cancelar</a>
    </div>
</main>
