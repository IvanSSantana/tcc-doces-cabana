@using DocesCabana.Application.DTOs
@using DocesCabana.Application.Enums
@using DocesCabana.MVC.Helpers
@model CatalogoDTO
@{
    static string RotuloOrdenacao(OrdenacaoCatalogo ordenacao) => ordenacao switch
    {
        OrdenacaoCatalogo.MaisVendidos => "Mais vendidos",
        OrdenacaoCatalogo.MelhorAvaliados => "Melhor avaliados",
        OrdenacaoCatalogo.MenorPreco => "Menor preço",
        OrdenacaoCatalogo.MaiorPreco => "Maior preço",
        OrdenacaoCatalogo.NomeAZ => "Nome (A-Z)",
        _ => ordenacao.ToString(),
    };
}

<div id="resultado-catalogo" tabindex="-1">
    @if (!string.IsNullOrWhiteSpace(Model.Termo))
    {
        <div class="etiqueta-busca-catalogo">
            <span>@Model.Termo</span>
            <a href="@EnderecoDoCatalogo.Montar(Url, Model.CategoriaAtual?.Apelido, Model.SubcategoriasMarcadas, Model.ApenasSemAcucar, Model.Ordenacao)"
               class="botao-remover-busca" aria-label="Remover busca por &quot;@Model.Termo&quot;">
                &times;
            </a>
        </div>
    }

    <div class="cabecalho-conteudo-catalogo">
        <span class="contagem-catalogo" aria-live="polite">
            @Model.Pagina.TotalDeItens produto@(Model.Pagina.TotalDeItens == 1 ? "" : "s")
        </span>

        <div class="controle-ordenacao">
            <label for="select-ordenacao">Ordenar por</label>
            <select id="select-ordenacao" name="ordenacao" onchange="this.form.requestSubmit()">
                @foreach (var opcao in Enum.GetValues<OrdenacaoCatalogo>())
                {
                    <option value="@opcao" selected="@(Model.Ordenacao == opcao ? "selected" : null)">
                        @RotuloOrdenacao(opcao)
                    </option>
                }
            </select>
        </div>
    </div>

    <noscript>
        <button type="submit" class="botao-aplicar-filtro">Aplicar</button>
    </noscript>

    @if (Model.Pagina.Itens.Count == 0)
    {
        if (!string.IsNullOrWhiteSpace(Model.Termo))
        {
            <p class="catalogo-vazio">
                Nenhum produto encontrado para &ldquo;@Model.Termo&rdquo;.
            </p>
        }
        else
        {
            <p class="catalogo-vazio">
                Nenhum produto encontrado com esses filtros. Tente desmarcar
                alguma subcategoria ou o filtro "sem açúcar".
            </p>
        }
    }
    else
    {
        <div class="grade-produtos">
            @foreach (var produto in Model.Pagina.Itens)
            {
                @await Component.InvokeAsync("CardProduto", new { produto, rotuloBotaoCarrinho = "Adicionar ao carrinho" })
            }
        </div>

        <partial name="_Paginacao" model="Model" />
    }
</div>
