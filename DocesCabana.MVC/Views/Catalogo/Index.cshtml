@using DocesCabana.Application.DTOs
@model CatalogoDTO
@{
    ViewData["Title"] = Model.CategoriaAtual?.Nome ?? "Catálogo";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/catalogo.css" asp-append-version="true">
<script src="~/js/pages/catalogo.js" defer></script>

<main class="pagina-catalogo">
    <nav class="trilha-catalogo" aria-label="Caminho de navegação">
        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a asp-area="" asp-controller="Catalogo" asp-action="Index" asp-route-ordenacao="@Model.Ordenacao">Todos</a>
        @if (Model.CategoriaAtual is not null)
        {
            <span aria-hidden="true">&rsaquo;</span>
            <span>@Model.CategoriaAtual.Nome</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Termo))
        {
            <span aria-hidden="true">&rsaquo;</span>
            <span>Resultados para &ldquo;@Model.Termo&rdquo;</span>
        }
    </nav>

    <form method="get" class="formulario-catalogo" id="formulario-catalogo">
        <input type="hidden" name="termo" value="@Model.Termo" />

        <div class="grade-catalogo">
            <aside class="barra-lateral-catalogo">
                <partial name="_BarraLateral" model="Model" />
            </aside>

            <section class="conteudo-catalogo">
                <partial name="_ResultadoCatalogo" model="Model" />
            </section>
        </div>
    </form>
</main>
