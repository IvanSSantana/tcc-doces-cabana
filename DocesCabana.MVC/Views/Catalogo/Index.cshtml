@using DocesCabana.Application.DTOs
@using DocesCabana.Application.Enums
@model CatalogoDTO
@{
    ViewData["Title"] = Model.CategoriaAtual?.Nome ?? "Catálogo";
    Layout = "_Layout";

    static string RotuloOrdenacao(OrdenacaoCatalogo ordenacao) => ordenacao switch
    {
        OrdenacaoCatalogo.MaisVendidos => "Mais vendidos",
        OrdenacaoCatalogo.MelhorAvaliados => "Melhor avaliados",
        OrdenacaoCatalogo.MenorPreco => "Menor preço",
        OrdenacaoCatalogo.MaiorPreco => "Maior preço",
        OrdenacaoCatalogo.NomeAZ => "Nome (A-Z)",
        _ => ordenacao.ToString(),
    };
}

<link rel="stylesheet" href="~/css/pages/catalogo.css" asp-append-version="true">

<main class="pagina-catalogo">
    <nav class="trilha-catalogo" aria-label="Caminho de navegação">
        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <a asp-area="" asp-controller="Catalogo" asp-action="Index" asp-route-ordenacao="@Model.Ordenacao">Todos</a>
        @if (Model.CategoriaAtual is not null)
        {
            <span aria-hidden="true">&rsaquo;</span>
            <span>@Model.CategoriaAtual.Nome</span>
        }
    </nav>

    @* Uma única <form method="get">: caixas de subcategoria, "sem açúcar" e
       ordenação se submetem juntos (plano §1). Sem action: submete para o
       próprio endereço, preservando o apelido de categoria que já está na
       URL — mesmo padrão que a 008 usa no seletor de ordenação de
       avaliações. *@
    <form method="get" class="formulario-catalogo">
        <div class="grade-catalogo">
            <aside class="barra-lateral-catalogo">
                <partial name="_BarraLateral" model="Model" />
            </aside>

            <section class="conteudo-catalogo">
                <div class="cabecalho-conteudo-catalogo">
                    <span class="contagem-catalogo">
                        @Model.Pagina.TotalDeItens produto@(Model.Pagina.TotalDeItens == 1 ? "" : "s")
                    </span>

                    <div class="controle-ordenacao">
                        <label for="select-ordenacao">Ordenar por</label>
                        <select id="select-ordenacao" name="ordenacao" onchange="this.form.submit()">
                            @foreach (var opcao in Enum.GetValues<OrdenacaoCatalogo>())
                            {
                                var indisponivel = opcao == OrdenacaoCatalogo.MaisVendidos;
                                <option value="@opcao"
                                        selected="@(Model.Ordenacao == opcao ? "selected" : null)"
                                        disabled="@(indisponivel ? "disabled" : null)">
                                    @RotuloOrdenacao(opcao)@(indisponivel ? " (em breve)" : "")
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <noscript>
                    <button type="submit" class="botao-aplicar-filtro">Aplicar</button>
                </noscript>

                @if (Model.Pagina.Itens.Count == 0)
                {
                    <p class="catalogo-vazio">
                        Nenhum produto encontrado com esses filtros. Tente desmarcar
                        alguma subcategoria ou o filtro "sem açúcar".
                    </p>
                }
                else
                {
                    <div class="grade-produtos">
                        @foreach (var produto in Model.Pagina.Itens)
                        {
                            @await Component.InvokeAsync("CardProduto", new { produto })
                        }
                    </div>

                    <partial name="_Paginacao" model="Model" />
                }
            </section>
        </div>
    </form>
</main>
