@using DocesCabana.Application.DTOs
@using DocesCabana.MVC.Helpers
@model CatalogoDTO

<h2 class="titulo-barra-lateral">Categorias</h2>

@* Os links de categoria preservam o termo de busca (spec 016, RF-05) —
   escolher uma categoria depois de buscar estreita o resultado, não
   recomeça a navegação. Nunca carregam subcategoria: trocar de categoria
   sempre reseta esse filtro (spec 014 §10). *@
<ul class="lista-categorias-catalogo">
    <li>
        <a href="@EnderecoDoCatalogo.Montar(Url, null, ordenacao: Model.Ordenacao, termo: Model.Termo)"
           class="link-categoria-catalogo @(Model.CategoriaAtual is null ? "link-categoria-catalogo--ativa" : "")">
            Todos
        </a>
    </li>
    @foreach (var categoria in Model.Categorias)
    {
        <li>
            <a href="@EnderecoDoCatalogo.Montar(Url, categoria.Apelido, ordenacao: Model.Ordenacao, termo: Model.Termo)"
               class="link-categoria-catalogo @(Model.CategoriaAtual?.CategoriaId == categoria.CategoriaId ? "link-categoria-catalogo--ativa" : "")">
                @categoria.Nome
            </a>
        </li>
    }
</ul>

@* RF-11: nenhuma caixa de subcategoria no catálogo completo. *@
@if (Model.CategoriaAtual is not null && Model.CategoriaAtual.Subcategorias.Count > 0)
{
    var principais = Model.CategoriaAtual.Subcategorias.Take(8).ToList();
    var restantes = Model.CategoriaAtual.Subcategorias.Skip(8).ToList();

    <fieldset class="filtro-subcategorias">
        <legend>Subcategorias</legend>

        @foreach (var subcategoria in principais)
        {
            <label class="opcao-filtro-catalogo">
                <input type="checkbox" name="subcategorias" value="@subcategoria.Apelido"
                       checked="@(Model.SubcategoriasMarcadas.Contains(subcategoria.Apelido) ? "checked" : null)"
                       onchange="this.form.requestSubmit()" />
                @subcategoria.Nome
            </label>
        }

        @* RF-10: as demais ficam sob um "Ver todas" que revela sem
           recarregar — <details> é nativo, sem JavaScript nenhum. *@
        @if (restantes.Count > 0)
        {
            @* RF-21/RF-22 (spec 015): os dois rótulos vivem na marcação —
               o CSS alterna qual aparece pelo estado [open] do próprio
               <details>, sem precisar de script para trocar texto. *@
            <details class="ver-todas-subcategorias">
                <summary>
                    <span class="rotulo-fechado">Ver todas</span>
                    <span class="rotulo-aberto">Ver menos</span>
                </summary>
                @foreach (var subcategoria in restantes)
                {
                    <label class="opcao-filtro-catalogo">
                        <input type="checkbox" name="subcategorias" value="@subcategoria.Apelido"
                               checked="@(Model.SubcategoriasMarcadas.Contains(subcategoria.Apelido) ? "checked" : null)"
                               onchange="this.form.requestSubmit()" />
                        @subcategoria.Nome
                    </label>
                }
            </details>
        }
    </fieldset>

    @* RN-04: filtro à parte — "sem açúcar" é característica do produto,
       não subcategoria; combina com elas em vez de competir. *@
    <div class="filtro-sem-acucar">
        <label class="opcao-filtro-catalogo">
            <input type="checkbox" name="semAcucar" value="true"
                   checked="@(Model.ApenasSemAcucar ? "checked" : null)"
                   onchange="this.form.requestSubmit()" />
            Sem açúcar
        </label>
    </div>
}
