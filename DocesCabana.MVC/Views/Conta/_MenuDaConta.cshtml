@{
    // "activePage" vem de ViewData, passado por cada view que inclui este
    // parcial — decide qual entrada do menu marca como atual.
    var paginaAtiva = ViewData["PaginaAtiva"] as string;
}

<nav class="menu-conta" aria-label="Menu da conta">
    <a asp-action="Index" class="link-menu-conta @(paginaAtiva == "DadosPessoais" ? "link-menu-conta--ativo" : "")">
        Dados pessoais
    </a>

    <a asp-action="Enderecos" class="link-menu-conta @(paginaAtiva == "Enderecos" ? "link-menu-conta--ativo" : "")">
        Endereços
    </a>

    @* A terceira seção nasce quando a 019 criar Pedido — o menu já reserva
       o lugar dela, desabilitado, em vez de precisar ganhar uma entrada
       nova depois (spec 018, plano §1). *@
    <span class="link-menu-conta link-menu-conta--desabilitado" aria-disabled="true" title="Ainda não disponível">
        Meus pedidos
    </span>
</nav>
