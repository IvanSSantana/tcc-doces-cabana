@using DocesCabana.Application.DTOs
@model EnderecoDTO
@{
    // O mesmo formulário serve cadastro e edição (plano §4) — a presença de
    // um EnderecoId de verdade é o que distingue os dois.
    var eEdicao = Model.EnderecoId != Guid.Empty;
    ViewData["Title"] = eEdicao ? "Editar endereço" : "Novo endereço";
    ViewData["PaginaAtiva"] = "Enderecos";
}

<link rel="stylesheet" href="~/css/components/formulario.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/pages/conta.css" asp-append-version="true">

<main class="pagina-conta">
    <h1 class="titulo-conta">Minha conta</h1>

    <div class="corpo-conta">
        <partial name="_MenuDaConta" />

        <section class="conteudo-conta">
            <h2 class="titulo-secao-conta">@(eEdicao ? "Editar endereço" : "Novo endereço")</h2>

            <partial name="_FormularioEndereco" model="Model" />
        </section>
    </div>
</main>

@section Scripts {
    <script src="~/js/pages/conta.js" asp-append-version="true"></script>
}
