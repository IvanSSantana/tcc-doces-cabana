<section class="pagina-inicial-vitrine">
    @await Component.InvokeAsync("VitrineProdutos", new { produtos = Model })
</section>

<h2 class="titulo" style="color: var(--cor-primaria);">Categorias</h2>

<partial name="_Categorias" />
