@using DocesCabana.Application.DTOs
@model IEnumerable<ProdutoDTO>

@{
    ViewData["Title"] = "Página Inicial";
}

<partial name="_Carrossel" model="@(ViewData["Banners"] as IReadOnlyList<BannerDoCarrosselDTO> ?? [])" />

<h2 class="titulo titulo--vitrine">Mais vendidos</h2>

<section class="pagina-inicial-vitrine">
    @await Component.InvokeAsync("VitrineProdutos", new { produtos = Model })
</section>

<h2 class="titulo titulo--verde titulo--categorias">Categorias</h2>

<partial name="_Categorias" />
