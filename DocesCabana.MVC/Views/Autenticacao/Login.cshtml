@using DocesCabana.Application.DTOs.Autenticacao;
@model LoginDTO
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutNaoAutenticado";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/pages/login.css">
    <title>@ViewData["Title"]</title>
</head>
<body>
    <main>
        <h1 class="titulo-login">Iniciar Sessão</h1>

        <form action="Login" method="post">
            <label asp-for="Login" class>E-mail ou número de telefone</label>
            <input asp-for="Login" type="text" placeholder="Digite seu login...">
            <span asp-validation-for="Login" class="texto-erro"></span>

            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" placeholder="Digite sua senha...">
            <span asp-validation-for="Senha" class="texto-erro"></span>

            <button type="submit" class="botao-login">Entrar</button>
        </form>

        <a asp-action="Cadastro" class="texto-link-login">Não tem uma conta?</a>
    </main>
</body>
</html>
