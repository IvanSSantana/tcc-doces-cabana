@using DocesCabana.Application.DTOs.Autenticacao;
@model LoginDTO
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutNaoAutenticado";
}

<link rel="stylesheet" href="~/css/components/formulario.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/pages/autenticacao.css" asp-append-version="true">

<main class="container-autenticacao">
    <h1 class="titulo-tela">Iniciar Sessão</h1>

    <form asp-action="Login" method="post" class="formulario-autenticacao">
        @* RF-13 (spec 015): o retorno sobrevive ao POST através deste campo
           oculto, para o login devolver a pessoa à página de onde ela partiu. *@
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="campo-entrada">
            <label asp-for="Login">E-mail ou CPF</label>
            <input asp-for="Login" type="text" placeholder="Digite seu login..." class="campo-texto" />
            <span asp-validation-for="Login" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Senha">Senha</label>
            <div class="campo-senha-container">
                <input asp-for="Senha" type="password" id="input-senha" placeholder="Digite sua senha..." class="campo-texto" />
                <button type="button" class="botao-mostrar-senha" onclick="toggleSenha('input-senha', 'svg-olho')" id="botao-toggle-senha" aria-label="Mostrar senha">
                    <i class="fa-regular fa-eye-slash icone-olho" id="svg-olho"></i>
                </button>
            </div>

            <span asp-validation-for="Senha" class="mensagem-erro"></span>

            @if (!ViewData.ModelState.IsValid)
            {
                var modelErrors = ViewData.ModelState[string.Empty]?.Errors;
                if (modelErrors != null && modelErrors.Any())
                {
                    <div class="resumo-erros">
                        @foreach (var erro in modelErrors)
                        {
                            <span class="mensagem-erro exibicao-bloco">@erro.ErrorMessage</span>
                        }
                    </div>
                }
            }
        </div>

        <div class="container-link">
            <a asp-action="EsqueceuSenha" class="link-navegacao" id="link-esqueceu-senha-login">Esqueceu a senha?</a>
            <a asp-action="Cadastro" class="link-navegacao">Criar uma conta</a>
        </div>

        <div class="container-botao">
            <button type="submit" class="botao-acao">Entrar</button>
        </div>
    </form>
</main>

@section Scripts {
    <script src="~/js/autenticacao.js" asp-append-version="true"></script>
}

