@using DocesCabana.Application.DTOs.Autenticacao;
@model LoginDTO
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutNaoAutenticado";
}

<link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true">

<main class="container-autenticacao">
    <h1 class="titulo-tela">Iniciar Sessão</h1>

    <form asp-action="Login" method="post" class="formulario-autenticacao">
        <div class="campo-entrada">
            <label asp-for="Login">E-mail ou número de telefone</label>
            <input asp-for="Login" type="text" placeholder="Digite seu login..." class="campo-texto" />
            <span asp-validation-for="Login" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Senha">Senha</label>
            <div class="campo-senha-wrapper">
                <input asp-for="Senha" type="password" id="input-senha" placeholder="Digite sua senha..." class="campo-texto" />
                <button type="button" class="botao-mostrar-senha" id="btn-toggle-senha" aria-label="Mostrar senha">
                    <svg id="svg-olho-fechado" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icone-olho">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                    <svg id="svg-olho-aberto" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icone-olho d-none">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Senha" class="mensagem-erro"></span>
        </div>

        <div class="container-link">
            <a asp-action="Cadastro" class="link-navegacao">Não tem uma conta?</a>
        </div>

        <div class="container-botao">
            <button type="submit" class="botao-acao">Entrar</button>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputSenha = document.getElementById("input-senha");
            const btnToggleSenha = document.getElementById("btn-toggle-senha");
            const svgOlhoFechado = document.getElementById("svg-olho-fechado");
            const svgOlhoAberto = document.getElementById("svg-olho-aberto");

            if (btnToggleSenha && inputSenha) {
                btnToggleSenha.addEventListener("click", function () {
                    if (inputSenha.type === "password") {
                        inputSenha.type = "text";
                        svgOlhoFechado.classList.add("d-none");
                        svgOlhoAberto.classList.remove("d-none");
                    } else {
                        inputSenha.type = "password";
                        svgOlhoAberto.classList.add("d-none");
                        svgOlhoFechado.classList.remove("d-none");
                    }
                });
            }
        });
    </script>
}

