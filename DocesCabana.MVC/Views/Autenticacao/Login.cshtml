@model DocesCabana.Application.DTOs.Autenticacao.LoginDTO
@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h2 class="mb-4">Entrar</h2>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Login" class="form-label">E-mail ou CPF</label>
                <input asp-for="Login" class="form-control" autocomplete="username" />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label">Senha</label>
                <input asp-for="Senha" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="LembrarMe" class="form-check-input" />
                <label asp-for="LembrarMe" class="form-check-label">Lembrar-me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>

        <p class="mt-3 text-center">
            Não tem conta? <a asp-action="Cadastro">Cadastre-se</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
