@using DocesCabana.Application.DTOs.Autenticacao;
@model CadastroDTO
@{
    ViewData["Title"] = "Cadastro";
    Layout = "_LayoutNaoAutenticado";
}

<link rel="stylesheet" href="~/css/pages/cadastro.css" asp-append-version="true">

<main class="container-autenticacao">
    <h1 class="titulo-tela">Cadastre-se</h1>

    <form asp-action="Cadastro" method="post" class="formulario-autenticacao">
        <div class="campo-entrada">
            <label asp-for="Nome">Nome Completo</label>
            <input asp-for="Nome" type="text" placeholder="Digite seu nome completo..." class="campo-texto" required />
            <span asp-validation-for="Nome" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" type="email" placeholder="Digite seu e-mail..." class="campo-texto" required />
            <span asp-validation-for="Email" class="mensagem-erro"></span>
        </div>

        <div class="linha-dupla">
            <div class="campo-entrada">
                <label asp-for="Telefone">Número de celular</label>
                <input asp-for="Telefone" type="tel" id="Telefone" placeholder="(00) 00000-0000" class="campo-texto" required />
                <span asp-validation-for="Telefone" class="mensagem-erro"></span>
            </div>

            <div class="campo-entrada">
                <label asp-for="DataNascimento">Data de Nascimento</label>
                <input asp-for="DataNascimento" type="text" id="DataNascimento" placeholder="DD/MM/AAAA" class="campo-texto" required />
                <span asp-validation-for="DataNascimento" class="mensagem-erro"></span>
            </div>
        </div>

        <div class="campo-entrada">
            <label asp-for="CPF">CPF</label>
            <input asp-for="CPF" type="text" id="CPF" placeholder="000.000.000-00" class="campo-texto" required />
            <span asp-validation-for="CPF" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" placeholder="Digite sua senha..." class="campo-texto" required />
            @if (ViewData.ModelState["Senha"]?.Errors.Any() == true)
            {
                foreach (var erro in ViewData.ModelState["Senha"].Errors)
                {
                    <span class="mensagem-erro d-block">@erro.ErrorMessage</span>
                }
            }
        </div>

        <div class="campo-entrada">
            <label asp-for="ConfirmacaoSenha">Confirmar Senha</label>
            <input asp-for="ConfirmacaoSenha" type="password" placeholder="Digite sua senha novamente..." class="campo-texto" required />
            <span asp-validation-for="ConfirmacaoSenha" class="mensagem-erro"></span>
        </div>

        <div class="container-link">
            <a asp-action="Login" class="link-navegacao">Já tem uma conta?</a>
        </div>

        <div class="container-botao">
            <button type="submit" class="botao-acao">Cadastrar</button>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputTelefone = document.getElementById("Telefone");
            const inputData = document.getElementById("DataNascimento");
            const inputCpf = document.getElementById("CPF");

            function formatTelefone(value) {
                const digits = value.replace(/\D/g, "").slice(0, 11);
                let formatted = "";
                if (digits.length > 0) {
                    formatted += "(" + digits.slice(0, 2);
                }
                if (digits.length > 2) {
                    formatted += ") " + digits.slice(2, 7);
                }
                if (digits.length > 7) {
                    formatted += "-" + digits.slice(7, 11);
                }
                return formatted;
            }

            function formatDataNascimento(value) {
                const digits = value.replace(/\D/g, "").slice(0, 8);
                let formatted = "";
                if (digits.length > 0) {
                    formatted += digits.slice(0, 2);
                }
                if (digits.length > 2) {
                    formatted += "/" + digits.slice(2, 4);
                }
                if (digits.length > 4) {
                    formatted += "/" + digits.slice(4, 8);
                }
                return formatted;
            }

            function formatCPF(value) {
                const digits = value.replace(/\D/g, "").slice(0, 11);
                let formatted = "";
                if (digits.length > 0) {
                    formatted += digits.slice(0, 3);
                }
                if (digits.length > 3) {
                    formatted += "." + digits.slice(3, 6);
                }
                if (digits.length > 6) {
                    formatted += "." + digits.slice(6, 9);
                }
                if (digits.length > 9) {
                    formatted += "-" + digits.slice(9, 11);
                }
                return formatted;
            }

            if (inputTelefone) {
                inputTelefone.addEventListener("input", function (e) {
                    e.target.value = formatTelefone(e.target.value);
                });
            }

            if (inputData) {
                inputData.addEventListener("input", function (e) {
                    e.target.value = formatDataNascimento(e.target.value);
                });
            }

            if (inputCpf) {
                inputCpf.addEventListener("input", function (e) {
                    e.target.value = formatCPF(e.target.value);
                });
            }
        });
    </script>
}