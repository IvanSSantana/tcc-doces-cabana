@using DocesCabana.Application.DTOs.Autenticacao;
@model CadastroDTO
@{
    ViewData["Title"] = "Cadastro";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
</head>
<body>
    <h1>Cadastre-se</h1>
    <form asp-action="Cadastro" method="post">
        <div class="campo-input">
            <label asp-for="Nome">Nome Completo</label>
            <input asp-for="Nome" type="text" required />
            <span asp-validation-for="Nome" class="texto-erro"></span>
        </div>

        <div class="campo-input">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" required />
            <span asp-validation-for="Email" class="texto-erro"></span>
        </div>

        <div class="campo-input">
            <label asp-for="Telefone">Número de celular</label>
            <input asp-for="Telefone" type="tel" required />
            <span asp-validation-for="Telefone" class="texto-erro"></span>
        </div>

        <div class="campo-input">
            <label asp-for="DataNascimento">Data de Nascimento</label>
            <input asp-for="DataNascimento" type="date" required />
            <span asp-validation-for="DataNascimento" class="texto-erro"></span>
        </div>

        <div class="campo-input">
            <label asp-for="CPF">CPF</label>
            <input asp-for="CPF" type="text" required />
            <span asp-validation-for="CPF" class="texto-erro"></span>
        </div>

        <div class="campo-input">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" required />
            <span asp-validation-for="Senha" class="texto-erro"></span>
        </div>
        
        <div class="campo-input">
            <label asp-for="ConfirmacaoSenha">Confirmar Senha</label>
            <input asp-for="ConfirmacaoSenha" type="password" required />
            <span asp-validation-for="ConfirmacaoSenha" class="texto-erro"></span>
        </div>

        <button type="submit">Cadastrar</button>
    </form>
</body>
</html>