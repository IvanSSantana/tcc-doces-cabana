@using DocesCabana.Domain.Enums
@model FormularioDeCupomViewModel

@{
    var cupom = Model.Cupom;
    var acao = Model.EhNovo ? "Cadastro" : "Edicao";
    var errosGerais = ViewData.ModelState[string.Empty]?.Errors;

    var tipos = new[]
    {
        (TipoDeDesconto.Percentual, "Percentual (%)"),
        (TipoDeDesconto.ValorFixo, "Valor fixo no pedido (R$)"),
        (TipoDeDesconto.CompreXLeveY, "Leve X, pague Y"),
        (TipoDeDesconto.FreteGratis, "Frete grátis"),
    };

    // A restrição não é um campo do cupom: só decide qual lista aparece.
    // O JS desabilita a lista escondida para que ela não seja enviada.
    var restricaoAtual = cupom.CategoriaId is not null ? "categoria"
        : cupom.SubcategoriaId is not null ? "subcategoria"
        : "nenhuma";

    var restricoes = new[]
    {
        ("nenhuma", "Todos os produtos"),
        ("categoria", "Uma categoria"),
        ("subcategoria", "Uma subcategoria"),
    };
}

<form asp-area="Admin" asp-controller="Cupom" asp-action="@acao" method="post"
      class="formulario-autenticacao formulario-promocao painel" data-formulario-cupom novalidate>
    @Html.AntiForgeryToken()

    @if (Model.EhNovo)
    {
        <div class="campo-entrada">
            <label asp-for="Cupom.Codigo">Código</label>
            <input asp-for="Cupom.Codigo" class="campo-texto campo-codigo-cupom" maxlength="20"
                   autocomplete="off" autocapitalize="characters" spellcheck="false"
                   placeholder="Ex.: BEMVINDO10" aria-describedby="ajuda-codigo" required />
            <small id="ajuda-codigo" class="texto-ajuda">
                De 3 a 20 letras ou números, sem espaços. O código não muda depois de criado.
            </small>
            <span asp-validation-for="Cupom.Codigo" class="mensagem-erro"></span>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="Cupom.CupomId" />
        <input type="hidden" asp-for="Cupom.Codigo" />
        <div class="campo-entrada">
            <span class="rotulo-codigo-fixo">Código</span>
            <p class="codigo-fixo-cupom">@cupom.Codigo</p>
            <small class="texto-ajuda">O código não muda depois de criado: quem já recebeu o cupom continua usando o mesmo.</small>
        </div>
    }

    <div class="campo-entrada">
        <label asp-for="Cupom.Descricao">Descrição (opcional, só para a equipe)</label>
        <input asp-for="Cupom.Descricao" class="campo-texto" maxlength="255" />
        <span asp-validation-for="Cupom.Descricao" class="mensagem-erro"></span>
    </div>

    <fieldset class="grupo-opcoes">
        <legend>Tipo de desconto</legend>
        <div class="opcoes-em-linha">
            @foreach (var (tipo, rotulo) in tipos)
            {
                <label class="opcao-radio">
                    <input type="radio" name="Cupom.Tipo" value="@tipo" checked="@(cupom.Tipo == tipo)" data-escolha-tipo />
                    @rotulo
                </label>
            }
        </div>
        <span asp-validation-for="Cupom.Tipo" class="mensagem-erro"></span>
    </fieldset>

    <div class="campo-entrada" data-campo-do-tipo="@TipoDeDesconto.Percentual @TipoDeDesconto.ValorFixo">
        <label asp-for="Cupom.Valor">Valor do desconto</label>
        <input asp-for="Cupom.Valor" type="text" inputmode="decimal" class="campo-texto campo-curto"
               aria-describedby="ajuda-valor" />
        <small id="ajuda-valor" class="texto-ajuda">
            Percentual: de 1 a 99, sobre os itens que o cupom alcança. Valor fixo: em reais, descontado uma vez do pedido e nunca mais que o valor desses itens.
        </small>
        <span asp-validation-for="Cupom.Valor" class="mensagem-erro"></span>
    </div>

    <div class="linha-dupla" data-campo-do-tipo="@TipoDeDesconto.CompreXLeveY">
        <div class="campo-entrada">
            <label asp-for="Cupom.QuantidadeLeve">Leve (unidades)</label>
            <input asp-for="Cupom.QuantidadeLeve" type="number" min="2" step="1" class="campo-texto" />
            <span asp-validation-for="Cupom.QuantidadeLeve" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Cupom.QuantidadePague">Pague (unidades)</label>
            <input asp-for="Cupom.QuantidadePague" type="number" min="1" step="1" class="campo-texto" />
            <span asp-validation-for="Cupom.QuantidadePague" class="mensagem-erro"></span>
        </div>
    </div>

    <p class="texto-ajuda" data-campo-do-tipo="@TipoDeDesconto.FreteGratis">
        O cupom zera o valor de qualquer entrega que o cliente escolher.
    </p>

    <div class="linha-dupla">
        <div class="campo-entrada">
            <label asp-for="Cupom.DataInicio">Começa em</label>
            <input asp-for="Cupom.DataInicio" type="date" asp-format="{0:yyyy-MM-dd}" class="campo-texto" required />
            <span asp-validation-for="Cupom.DataInicio" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Cupom.DataFim">Termina em (inclusive)</label>
            <input asp-for="Cupom.DataFim" type="date" asp-format="{0:yyyy-MM-dd}" class="campo-texto" required />
            <span asp-validation-for="Cupom.DataFim" class="mensagem-erro"></span>
        </div>
    </div>

    <fieldset class="grupo-opcoes grupo-restricoes-cupom">
        <legend>Restrições</legend>

        <div class="campo-entrada">
            <label asp-for="Cupom.ValorMinimo">Valor mínimo (opcional)</label>
            <input asp-for="Cupom.ValorMinimo" type="text" inputmode="decimal" class="campo-texto campo-curto"
                   aria-describedby="ajuda-minimo" />
            <small id="ajuda-minimo" class="texto-ajuda">
                Em reais, somando só os itens que o cupom alcança. O frete não conta.
            </small>
            <span asp-validation-for="Cupom.ValorMinimo" class="mensagem-erro"></span>
        </div>

        <label class="opcao-radio">
            <input asp-for="Cupom.UmUsoPorCliente" type="checkbox" />
            Cada cliente pode usar só uma vez
        </label>

        <div class="campo-entrada">
            <span class="rotulo-grupo-restricao" id="rotulo-vale-para">Vale para</span>
            <div class="opcoes-em-linha" role="radiogroup" aria-labelledby="rotulo-vale-para">
                @foreach (var (valor, rotulo) in restricoes)
                {
                    <label class="opcao-radio">
                        <input type="radio" name="restricao" value="@valor" checked="@(restricaoAtual == valor)" data-escolha-restricao />
                        @rotulo
                    </label>
                }
            </div>
        </div>

        <div class="campo-entrada" data-campo-da-restricao="categoria">
            <label asp-for="Cupom.CategoriaId">Categoria</label>
            <select asp-for="Cupom.CategoriaId" class="campo-texto">
                <option value="">Selecione...</option>
                @foreach (var categoria in Model.Categorias.OrderBy(c => c.Nome))
                {
                    <option value="@categoria.CategoriaId" selected="@(cupom.CategoriaId == categoria.CategoriaId)">@categoria.Nome</option>
                }
            </select>
            <span asp-validation-for="Cupom.CategoriaId" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada" data-campo-da-restricao="subcategoria">
            <label asp-for="Cupom.SubcategoriaId">Subcategoria</label>
            <select asp-for="Cupom.SubcategoriaId" class="campo-texto">
                <option value="">Selecione...</option>
                @foreach (var categoria in Model.Categorias.OrderBy(c => c.Nome))
                {
                    <optgroup label="@categoria.Nome">
                        @foreach (var subcategoria in categoria.Subcategorias.OrderBy(s => s.Nome))
                        {
                            <option value="@subcategoria.SubcategoriaId" selected="@(cupom.SubcategoriaId == subcategoria.SubcategoriaId)">@subcategoria.Nome</option>
                        }
                    </optgroup>
                }
            </select>
            <span asp-validation-for="Cupom.SubcategoriaId" class="mensagem-erro"></span>
        </div>
    </fieldset>

    @if (errosGerais != null && errosGerais.Any())
    {
        <div class="resumo-erros">
            @foreach (var erro in errosGerais)
            {
                <span class="mensagem-erro exibicao-bloco">@erro.ErrorMessage</span>
            }
        </div>
    }

    <div class="rodape-formulario-promocao">
        <a asp-area="Admin" asp-controller="Cupom" asp-action="Index" class="botao botao--secundario">Cancelar</a>
        <button type="submit" class="botao botao--primario">@(Model.EhNovo ? "Cadastrar cupom" : "Salvar alterações")</button>
    </div>
</form>
