@model FormularioDeCupomViewModel
@{
    ViewData["Title"] = "Novo cupom";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/gestao-produtos.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/pages/gestao-promocoes.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/pages/gestao-cupons.css" asp-append-version="true">

<main class="container-gestao-produtos container-formulario-promocao">
    <div class="cabecalho-gestao">
        <h1 class="titulo-gestao">Novo cupom</h1>
        <a asp-area="Admin" asp-controller="Cupom" asp-action="Index" class="botao botao--secundario">Voltar</a>
    </div>

    <partial name="_FormularioCupom" model="Model" />
</main>

@section Scripts {
    <script src="~/js/pages/gestao-cupons.js" asp-append-version="true"></script>
}
