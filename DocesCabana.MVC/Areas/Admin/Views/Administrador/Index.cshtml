@using DocesCabana.Application.DTOs
@model List<AdministradorDTO>
@{
    ViewData["Title"] = "Administradores";
    Layout = "_Layout";
    var ehPrincipal = ViewData["EhPrincipal"] is true;
}

<link rel="stylesheet" href="~/css/pages/gestao-produtos.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/pages/administradores.css" asp-append-version="true">

<main class="container-administradores">
    <div class="cabecalho-administradores">
        <h1 class="titulo-tela">Administradores</h1>
        <a asp-action="Cadastro" class="botao botao--primario botao-novo-administrador">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            Novo administrador
        </a>
    </div>

    @if (TempData["Confirmacao"] is string confirmacao)
    {
        <div class="resumo-sucesso">
            <span class="mensagem-sucesso exibicao-bloco">@confirmacao</span>
        </div>
    }

    @if (!Model.Any())
    {
        <p class="mensagem-vazia">Nenhum administrador cadastrado.</p>
    }
    else
    {
        <table class="tabela-administradores">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Situação</th>
                    @if (ehPrincipal)
                    {
                        <th class="coluna-acoes">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var administrador in Model)
                {
                    <tr>
                        <td>
                            @administrador.Nome
                            @if (administrador.Principal)
                            {
                                <span class="selo-principal">Principal</span>
                            }
                        </td>
                        <td>@administrador.Email</td>
                        <td>
                            @if (administrador.Ativo)
                            {
                                <span class="selo-status selo-status--ativo">Ativo</span>
                            }
                            else
                            {
                                <span class="selo-status selo-status--inativo">Desativado</span>
                            }
                        </td>
                        @if (ehPrincipal)
                        {
                            <td class="coluna-acoes">
                                @if (!administrador.Principal)
                                {
                                    <div class="acoes-produto">
                                        <a asp-area="Admin" asp-controller="Administrador" asp-action="Editar"
                                           asp-route-id="@administrador.Id"
                                           class="botao botao--icone botao--pequeno botao-icone" title="Editar" aria-label="Editar @administrador.Nome">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="Administrador"
                                              asp-action="@(administrador.Ativo ? "Desativar" : "Reativar")"
                                              asp-route-id="@administrador.Id" method="post"
                                              onsubmit="return confirm('@(administrador.Ativo ? "Desativar este administrador? Ele não conseguirá mais entrar." : "Reativar este administrador?")');">
                                            @Html.AntiForgeryToken()
                                            @if (administrador.Ativo)
                                            {
                                                <button type="submit" class="botao botao--icone botao--pequeno botao-icone" title="Desativar" aria-label="Desativar @administrador.Nome">
                                                    <i class="fa-solid fa-user-slash" aria-hidden="true"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="botao botao--icone botao--pequeno botao-icone" title="Reativar" aria-label="Reativar @administrador.Nome">
                                                    <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</main>
