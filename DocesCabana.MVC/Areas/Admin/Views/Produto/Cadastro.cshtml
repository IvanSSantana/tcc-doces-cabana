@using DocesCabana.Application.DTOs
@using DocesCabana.Domain.Enums
@model ProdutoDTO

@{
    ViewData["Title"] = "Cadastrar Produto";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/components/formulario.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/pages/cadastro_produto.css" asp-append-version="true">

@* pagina-cadastro-produto escopa o empilhamento em tela estreita (RF-17)
   só a esta tela — .linha-dupla em si não empilha em nenhuma largura
   (achado ao verificar, plano previa que já empilhava; não é regressão
   desta feature, então as outras duas telas que a usam não são tocadas). *@
<main class="container-autenticacao pagina-cadastro-produto">
<h1 class="titulo-tela">Cadastrar Produto</h1>

<form asp-action="Cadastro" method="post" enctype="multipart/form-data" class="formulario-autenticacao">
    @Html.AntiForgeryToken()

    <div class="campo-entrada">
        <label asp-for="Nome">Nome do Produto</label>
        <input asp-for="Nome" class="campo-texto" placeholder="Digite o nome do produto..." required />

        <span asp-validation-for="Nome" class="mensagem-erro"></span>
    </div>

    @* Preço e Status dividem a linha em tela larga, empilham na estreita
       (spec 016, RF-17) — mesmo .linha-dupla que o cadastro de
       administrador já usa. *@
    <div class="linha-dupla">
        <div class="campo-entrada">
            <label asp-for="Preco">Preço</label>
            <input asp-for="Preco" type="number" min="0" step="0.01" class="campo-texto" placeholder="Digite o preço do produto..." required />

            <span asp-validation-for="Preco" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Status">Status</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProdutoStatus>()" class="campo-texto">
                <option value="">Selecione...</option>
            </select>

            <span asp-validation-for="Status" class="mensagem-erro"></span>
        </div>
    </div>

    @* Substitui o campo de endereço (spec 027, RF-01) — quem preenche
       ImagemUrl passa a ser o servidor, depois do envio. O erro mora na
       chave "imagem" do ModelState, não numa propriedade do model — mesmo
       caminho que o CEP usa em _ItensDoCarrinho.cshtml (spec 020). *@
    <div class="campo-entrada">
        <label for="imagem">Imagem</label>
        <input type="file" id="imagem" name="imagem" class="campo-texto" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required />

        @{
            var erroDaImagem = ViewData.ModelState["imagem"]?.Errors.FirstOrDefault()?.ErrorMessage;
        }
        @if (erroDaImagem is not null)
        {
            <span class="mensagem-erro exibicao-bloco">@erroDaImagem</span>
        }
    </div>

    <div class="linha-dupla">
        <div class="campo-entrada">
            <label asp-for="SubcategoriaId">Subcategoria</label>
            <select asp-for="SubcategoriaId" asp-items="ViewBag.Subcategorias" class="campo-texto">
                <option value="">Selecione...</option>
            </select>

            <span asp-validation-for="SubcategoriaId" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada campo-caixa-selecao">
            <label asp-for="SemAcucar">
                <input asp-for="SemAcucar" type="checkbox" />
                Sem açúcar
            </label>
        </div>
    </div>

    @* Peso e dimensões (spec 020, RF-02) — mesmo .linha-dupla que Preço/Status
       já usa, empilhando em tela estreita. *@
    <div class="linha-dupla">
        <div class="campo-entrada">
            <label asp-for="Peso">Peso (kg)</label>
            <input asp-for="Peso" type="number" min="0" step="0.001" class="campo-texto" placeholder="Digite o peso em kg..." required />

            <span asp-validation-for="Peso" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Altura">Altura (cm)</label>
            <input asp-for="Altura" type="number" min="0" step="0.1" class="campo-texto" placeholder="Digite a altura em cm..." required />

            <span asp-validation-for="Altura" class="mensagem-erro"></span>
        </div>
    </div>

    <div class="linha-dupla">
        <div class="campo-entrada">
            <label asp-for="Largura">Largura (cm)</label>
            <input asp-for="Largura" type="number" min="0" step="0.1" class="campo-texto" placeholder="Digite a largura em cm..." required />

            <span asp-validation-for="Largura" class="mensagem-erro"></span>
        </div>

        <div class="campo-entrada">
            <label asp-for="Comprimento">Comprimento (cm)</label>
            <input asp-for="Comprimento" type="number" min="0" step="0.1" class="campo-texto" placeholder="Digite o comprimento em cm..." required />

            <span asp-validation-for="Comprimento" class="mensagem-erro"></span>
        </div>
    </div>

    <div class="campo-entrada">
        <label asp-for="Descricao">Descrição (opcional)</label>
        <textarea asp-for="Descricao" class="campo-texto" rows="5" maxlength="4000"
            placeholder="Descreva o produto — aparece na página dele para o cliente."></textarea>

        <span asp-validation-for="Descricao" class="mensagem-erro"></span>
    </div>

    @if (TempData["Confirmacao"] is string confirmacao)
    {
        <div class="resumo-sucesso">
            <span class="mensagem-sucesso exibicao-bloco">@confirmacao</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        var erros = ViewData.ModelState[string.Empty]?.Errors;

        if (erros != null && erros.Any())
        {
            <div class="resumo-erros">
                @foreach (var erro in erros)
                {
                    <span class="mensagem-erro exibicao-bloco">@erro.ErrorMessage</span>
                }
            </div>
        }
    }

    <div class="container-botao">
        <button type="submit" class="botao-acao">Cadastrar Produto</button>
    </div>

</form>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
